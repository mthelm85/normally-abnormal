	import raisesStats from './data/raises-stats.csv';
	const rs = Object.fromEntries(raisesStats.map((r) => [r.stat, r.value]));
	import homeStats from './data/home-values-stats.csv';
	import statePair from './data/state-pair.csv';
	import statePairStats from './data/state-pair-stats.csv';
	import statePairTable from './data/state-pair-table.csv';
	import stateContrast from './data/state-contrast.csv';
	import stateContrastStats from './data/state-contrast-stats.csv';
	import stateContrastTable from './data/state-contrast-table.csv';
	import stateContrastSd from './data/state-contrast-sd-table.csv';
	import stateContrastGeo from './data/state-contrast-geo-table.csv';
	const sc = Object.fromEntries(stateContrastStats.map((r) => [r.stat, r.value]));
